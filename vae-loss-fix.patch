diff --git a/ml/docs/architecture.md b/ml/docs/architecture.md
index d168715..7181c38 100644
--- a/ml/docs/architecture.md
+++ b/ml/docs/architecture.md
@@ -113,6 +113,8 @@ total = recon + kl_weight * kl
 
 `block_id` is weighted highest because predicting the wrong material is more damaging to visual quality than predicting a slightly wrong orientation.
 
+Each reconstruction term is cross-entropy summed over the 16³ voxels and averaged over the batch, so it sits on the same per-sample scale as the KL term. `logvar` is clamped to [-10, 10] in the encoder to keep `exp(logvar)` finite under fp16.
+
 ## KL annealing
 
 Without annealing, the KL term dominates early in training and forces the encoder to collapse all inputs onto the prior — the decoder then ignores the latent code entirely (posterior collapse), and generation becomes unconditional noise.
diff --git a/ml/docs/training.md b/ml/docs/training.md
index 2242ea0..76884f8 100644
--- a/ml/docs/training.md
+++ b/ml/docs/training.md
@@ -135,7 +135,7 @@ Epoch   42/100 | loss=2.3451  recon=1.8234  kl=0.5217  block_acc=0.4821  kl_w=1.
 | Field | Meaning |
 |---|---|
 | `loss` | Total ELBO loss (recon + kl_weight × kl) |
-| `recon` | Weighted reconstruction loss across all 5 block state components |
+| `recon` | Weighted reconstruction loss across all 5 block state components (nats per chunk, so values are in the thousands) |
 | `kl` | KL divergence, normalized by batch size |
 | `block_acc` | Fraction of voxels where the predicted block ID argmax matches ground truth |
 | `kl_w` | Current KL weight (0 → 1 over first 20 epochs) |
diff --git a/ml/model/encoder.py b/ml/model/encoder.py
index de5fd0c..f75a155 100644
--- a/ml/model/encoder.py
+++ b/ml/model/encoder.py
@@ -72,6 +72,7 @@ class Encoder(nn.Module):
         h = torch.cat([h, c], dim=-1)    # [B, 1024 + COND_DIM]
 
         mu     = self.mu_head(h)         # [B, LATENT_DIM]
-        logvar = self.logvar_head(h)     # [B, LATENT_DIM]
+        # Clamp so exp(logvar) can't overflow (esp. under fp16 autocast)
+        logvar = self.logvar_head(h).clamp(-10.0, 10.0)  # [B, LATENT_DIM]
 
         return mu, logvar
diff --git a/ml/model/vae.py b/ml/model/vae.py
index 553d525..ba7aaf9 100644
--- a/ml/model/vae.py
+++ b/ml/model/vae.py
@@ -201,6 +201,18 @@ class ConditionalChunkVAE(nn.Module):
 # Loss function
 # ---------------------------------------------------------------------------
 
+def _ce_per_sample(logits: torch.Tensor, target: torch.Tensor) -> torch.Tensor:
+    """
+    Cross-entropy summed over all voxels, averaged over the batch.
+
+    Summing over voxels (instead of F.cross_entropy's default mean over
+    B*16^3 positions) keeps the reconstruction term on the same per-sample
+    scale as the KL term, which is a sum over latent dims per sample. With
+    the mean, KL was ~4096x too strong and pushed toward posterior collapse.
+    """
+    return F.cross_entropy(logits.float(), target.long(), reduction="sum") / logits.shape[0]
+
+
 def vae_loss(
     outputs:   dict[str, torch.Tensor],   # raw logits from decoder
     targets:   dict[str, torch.Tensor],   # integer ground truth [B, 16, 16, 16]
@@ -218,18 +230,22 @@ def vae_loss(
         half     × 0.3
         shape    × 0.3
 
-    KL term: normalized by batch size, scaled by kl_weight (annealed during training).
+    Each reconstruction term is summed over the 16^3 voxels and averaged over
+    the batch (per-sample nats), matching the KL term's scale.
+
+    KL term: summed over latent dims, averaged over the batch, scaled by
+    kl_weight (annealed during training).
 
     Returns:
         total_loss  — scalar
         recon_loss  — scalar (unweighted sum for logging)
         kl_loss     — scalar (unnormalized for logging)
     """
-    recon_block  = F.cross_entropy(outputs["block_id"], targets["block_id"])
-    recon_facing = F.cross_entropy(outputs["facing"],   targets["facing"])
-    recon_axis   = F.cross_entropy(outputs["axis"],     targets["axis"])
-    recon_half   = F.cross_entropy(outputs["half"],     targets["half"])
-    recon_shape  = F.cross_entropy(outputs["shape"],    targets["shape"])
+    recon_block  = _ce_per_sample(outputs["block_id"], targets["block_id"])
+    recon_facing = _ce_per_sample(outputs["facing"], targets["facing"])
+    recon_axis   = _ce_per_sample(outputs["axis"], targets["axis"])
+    recon_half   = _ce_per_sample(outputs["half"], targets["half"])
+    recon_shape  = _ce_per_sample(outputs["shape"], targets["shape"])
 
     recon = (
         recon_block  * 1.0
@@ -240,6 +256,7 @@ def vae_loss(
     )
 
     # KL divergence: -0.5 * sum(1 + logvar - mu² - exp(logvar))
+    mu, logvar = mu.float(), logvar.float()
     kl = -0.5 * torch.sum(1 + logvar - mu.pow(2) - logvar.exp()) / mu.shape[0]
 
     total = recon + kl_weight * kl
